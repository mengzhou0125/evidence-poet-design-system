#!/bin/sh
# Evidence Poet (DNA1) auditor · pre-commit gate
# Install: cp this to .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Point EPDS_AUDITOR at the deployed auditor (default: ~/.claude/skills/evidence-poet-auditor).

EPDS_AUDITOR="${EPDS_AUDITOR:-$HOME/.claude/skills/evidence-poet-auditor}"
TARGET="./src"                       # adjust to your source dir
SPEC=".claude/design.md"             # adjust if your spec lives elsewhere

node "$EPDS_AUDITOR/audit.mjs" "$TARGET" --spec="$SPEC" --format=summary
code=$?

case "$code" in
  3) echo "✗ EPDS auditor: P0 drift — commit blocked. Fix the must-fix items above." ; exit 1 ;;
  2) echo "✗ EPDS auditor: setup error (spec/path?). Commit blocked." ; exit 1 ;;
  1) echo "⚠ EPDS auditor: P1 suggestions present (not blocking)." ; exit 0 ;;
  *) exit 0 ;;
esac
